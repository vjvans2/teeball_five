<h1><%= @game.full_legal_game_name%></h1>
<h4> --- Game Assignments --- </h4>
<br>
<table>
  <thead>
    <tr>
      <th style="text-align: center; border: 1px solid black; padding: 8px;">Batting Order</th>
      <th style="text-align: center; border: 1px solid black; padding: 8px;">Player</th>
      <th style="text-align: center; border: 1px solid black; padding: 8px;">#</th>
      <% 1.upto(6) do |inning| %>
        <th style="text-align: center; border: 1px solid black; padding: 8px;">Inning <%= inning %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <% @game.game_assignments.each do |player_data| %>
      <tr>
        <td style="text-align: center; border: 1px solid black; padding: 8px;";><%= player_data[:batting_order] %></td>
        <td style="text-align: center; border: 1px solid black; padding: 8px;";><%= player_data[:player][:name] %></td>
        <td style="text-align: center; border: 1px solid black; padding: 8px;";><%= player_data[:player][:jersey_number] %></td>
        <% player_data[:game_assignments].each do |assignment| %>
          <td style="text-align: center; border: 1px solid black; padding: 8px;";><%= assignment[:position] %></td>
        <% end %>
      </tr>
    <% end %>
  </tbody>
</table>
<br><br>

<div class="mb-3">
  <%= link_to 'All Teams', teams_path, class: "btn btn-primary" %>
  <%= link_to 'All Games', games_path, class: "btn btn-info" %>
  <%= link_to 'Edit Game Details', edit_game_path(@game), class: "btn btn-warning" %>
  <%= link_to 'Edit Player Details', edit_game_player_innings_path(gameday_team_id: @game.gameday_team.id), class: "btn btn-warning" %>
  <%= link_to 'Delete Game', game_path(@game), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: "btn btn-danger" %>
</div>
